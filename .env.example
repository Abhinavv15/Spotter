# Spotter - Full-Stack HOS Route Planner & ELD Log Generator
# Environment Variables Configuration

# Backend Settings
DJANGO_SECRET_KEY=django-insecure-replace-in-production-spotter-key-xyz123
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (Leave empty for local development SQLite; set URL for PostgreSQL)
DATABASE_URL=

# Routing & Geocoding APIs
# Default uses open public OSRM & Photon/Nominatim services
OSRM_ROUTING_URL=https://router.project-osrm.org/route/v1/driving
GEOCODING_API_URL=https://photon.komoot.io/api

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000/api
